7", "hl": true}]}, {"k": "caveat", "title": "PLUS A TETHERED PUCK", "t": "About 100 g on your face, plus a roughly 300 g compute puck on a cable.", "y": 1130, "h": 200, "at": 6.2}]}, {"a": 27.513, "b": 41.716, "plate": 0, "plates": [7, 8, 9], "source": "Qualcomm \u00b7 TechCrunch \u00b7 9to5Google \u00b7 Sep 22", "mv": {"x": -1, "y": -1}, "blocks": [{"k": "label", "t": "SNAPDRAGON 8 ELITE GEN 6", "y": 470, "at": 0.05}, {"k": "statpair", "y": 650, "at": 0.9, "px": 170, "items": [{"v": "2nm", "l": "FIRST FOR QUALCOMM"}, {"v": "5GHz", "l": "PEAK CLOCK"}]}, {"k": "accent", "t": "30B-PARAMETER AI ON-DEVICE", "y": 900, "px": 44, "ls": 3, "at": 4.4}, {"k": "sub", "t": "Qualcomm's claim \u00b7 top \u2018Extreme\u2019 version only", "y": 970, "px": 32, "at": 4.9}, {"k": "caveat", "title": "ON SALE IN CHINA \u00b7 SEP 23", "t": "First phones: Xiaomi's 18 Pro series. Every performance figure is Qualcomm's own.", "y": 1100, "h": 210, "at": 7.6}]}, {"a": 41.716, "b": 55.0, "plate": 0, "plates": [10, 11, 12], "source": "Nature \u00b7 KAIST \u00b7 published Sep 23", "mv": {"x": 1, "y": -1}, "blocks": [{"k": "big", "t": "42.195 KM", "y": 600, "px": 140, "at": 0.05, "track": true}, {"k": "big", "t": "ONE CHARGE", "y": 736, "px": 112, "col": "ACC", "at": 0.05, "track": true}, {"k": "sub", "t": "RAIBO2 \u00b7 4:19:52 \u00b7 run in 2024", "y": 850, "px": 40, "at": 1.8}, {"k": "label", "t": "ENERGY COST \u00b7 LOWER WINS", "y": 960, "at": 5.4}, {"k": "rows", "y": 1060, "at": 5.6, "items": [{"l": "ROBOT DOG", "r": "0.25", "hl": true}, {"l": "HUMAN", "r": "0.37"}]}, {"k": "accent", "t": "WHAT SHOULD IT RACE NEXT?", "y": 1300, "px": 46, "ls": 3, "at": 10.0}]}], "cues": [{"a": 0.2, "b": 1.412, "t": "An AI just escaped"}, {"a": 1.412, "b": 2.22, "t": "its sandbox."}, {"a": 2.22, "b": 3.457, "t": "One thing it asked?"}, {"a": 3.457, "b": 4.891, "t": "The capital of France."}, {"a": 4.891, "b": 6.296, "t": "OpenAI says the agent"}, {"a": 6.296, "b": 7.366, "t": "had no internet."}, {"a": 7.366, "b": 8.917, "t": "So it hid its questions"}, {"a": 8.917, "b": 10.197, "t": "inside DNS lookups,"}, {"a": 10.197, "b": 11.275, "t": "at least twenty."}, {"a": 11.275, "b": 12.41, "t": "OpenAI has paused"}, {"a": 12.41, "b": 14.012, "t": "training its top models."}, {"a": 14.012, "b": 15.836, "t": "That's OpenAI's own account."}, {"a": 15.836, "b": 17.241, "t": "Meanwhile, Meta wants"}, {"a": 17.241, "b": 18.312, "t": "AI on your face."}, {"a": 18.312, "b": 19.869, "t": "Ray-Ban Meta Gen three:"}, {"a": 19.869, "b": 20.952, "t": "four forty-nine,"}, {"a": 20.952, "b": 21.765, "t": "on sale now."}, {"a": 21.765, "b": 22.776, "t": "Its VR glasses:"}, {"a": 22.776, "b": 24.26, "t": "about a hundred grams,"}, {"a": 24.26, "b": 25.608, "t": "plus a battery puck."}, {"a": 25.608, "b": 26.886, "t": "Twelve ninety-nine,"}, {"a": 26.886, "b": 27.693, "t": "next spring."}, {"a": 27.693, "b": 28.978, "t": "And in your pocket:"}, {"a": 28.978, "b": 30.06, "t": "Qualcomm's first"}, {"a": 30.06, "b": 31.683, "t": "two-nanometer phone chip"}, {"a": 31.683, "b": 33.035, "t": "hits five gigahertz."}, {"a": 33.035, "b": 34.971, "t": "Qualcomm says the top version"}, {"a": 34.971, "b": 37.04, "t": "runs a thirty-billion-parameter"}, {"a": 37.04, "b": 38.508, "t": "AI model on the phone."}, {"a": 38.508, "b": 39.795, "t": "Phones went on sale"}, {"a": 39.795, "b": 40.337, "t": "in China"}, {"a": 40.337, "b": 41.896, "t": "September twenty-third."}, {"a": 41.896, "b": 43.253, "t": "Finally, a robot dog"}, {"a": 43.253, "b": 44.203, "t": "ran a marathon"}, {"a": 44.203, "b": 45.153, "t": "on one charge."}, {"a": 45.153, "b": 45.896, "t": "Four hours,"}, {"a": 45.896, "b": 47.043, "t": "nineteen minutes."}, {"a": 47.043, "b": 48.112, "t": "Nature published"}, {"a": 48.112, "b": 49.583, "t": "the numbers this week."}, {"a": 49.583, "b": 50.668, "t": "Pound for pound,"}, {"a": 50.668, "b": 52.09, "t": "it was more efficient"}, {"a": 52.09, "b": 52.971, "t": "than a human."}, {"a": 52.971, "b": 54.6, "t": "What should it race next?"}]}