# Leave blank to run fully offline against the built-in mock coordinator (sample tasks, fake payouts).
EXPO_PUBLIC_COORDINATOR_URL=
# RevenueCat public SDK keys. Blank = dev-only mock store (purchases apply locally, no charge).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Earnings-affecting IAPs (boosts, fee tiers, premium tasks). Keep false until store review
# has cleared them for your listing — see docs/STORE-COMPLIANCE.md.
EXPO_PUBLIC_EARNINGS_IAP_ENABLED=false
# Anonymous analytics endpoint (defaults to <coordinator>/v1/analytics). Only used with consent.
EXPO_PUBLIC_ANALYTICS_URL=
