# --- server
PORT=8787
HOST=0.0.0.0
# Pepper mixed into stored device-token hashes. Generate: openssl rand -hex 32
TOKEN_PEPPER=change-me

# --- task supply
# true = keep the queue topped up with sample tasks (dev/staging only)
SEED_SAMPLE_TASKS=true
# Comma-separated API keys for requesters posting real tasks to /v1/requester/tasks
REQUESTER_API_KEYS=

# --- payouts
PAYOUT_MIN_SATS=250
# mock | lnd
LIGHTNING_PROVIDER=mock
# LND REST (e.g. a Voltage node): https://<node>.m.voltageapp.io:8080
LND_REST_URL=
# Hex-encoded macaroon. Bake a restricted one: lncli bakemacaroon offchain:read offchain:write
LND_MACAROON_HEX=

# --- in-app purchases (RevenueCat webhook)
REVENUECAT_WEBHOOK_SECRET=

# --- market display
# Optional fixed BTC/USD reference for rough fiat display; leave blank to hide fiat.
BTC_USD_REFERENCE=
